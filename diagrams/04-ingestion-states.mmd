---
config:
  layout: elk
  flowchart:
    curve: linear
    nodeSpacing: 48
    rankSpacing: 66
  themeVariables:
    fontSize: 16px
---
flowchart LR
    Start(( ))
    Queued[Queued]
    Processing[Processing]
    Retrying[Retrying]
    Succeeded[Succeeded]
    DeadLetter[Dead letter]
    Finish((( )))

    Start -->|"enqueue / initial transition"| Queued
    Queued -->|"claim [available] / lease; attempts++"| Processing
    Processing -->|"commitSucceeded / persist result + outbox"| Succeeded
    Succeeded --> Finish

    Processing -->|"retryable failure [budget remains] / delay"| Retrying
    Processing -->|"leaseExpired / recover"| Retrying
    Retrying -->|"claim [available] / renew lease; attempts++"| Processing

    Processing -->|"permanent failure or budget exhausted / retain error"| DeadLetter
    DeadLetter -->|"manual redrive [authorized, eligible] / reset attempts"| Queued

    classDef state fill:#f5faf7,stroke:#047857,color:#17211d,stroke-width:1.5px;
    classDef marker fill:#17211d,stroke:#17211d,color:#17211d;
    classDef finish fill:#ffffff,stroke:#17211d,color:#17211d,stroke-width:2px;
    class Queued,Processing,Retrying,Succeeded,DeadLetter state;
    class Start marker;
    class Finish finish;
